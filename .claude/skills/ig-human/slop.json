  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)(?:\\bnão é (?:só|apenas|somente) [^.!?\\n]{2,60}[,.] é\\b)|(?:\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b)",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade da preparação."
    },
    {
      "id": "not-only",
      "regex": "(?i)(?:\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas (?:também|tb)\\b)|(?:\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b)",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebre em duas frases, ou corte a metade mais fraca."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)(?:\\bnão é sobre [^.!?\\n]{2,60}[.!,] é sobre\\b)|(?:\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b)",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é o sinal."
    },
    {
      "id": "the-result",
      "regex": "(?i)(?:^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|a pegadinha|resultado)\\?\\s*$)|(?:^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$)",
      "name": "Linha com pergunta retórica de uma palavra",
      "fix": "Responda na própria frase em vez de encenar uma revelação."
    },
    {
      "id": "heres-what",
      "regex": "(?i)(?:\\b(?:aqui está|eis|olha) o que (?:eu|nós|a gente) aprend\\w+\\b|\\bo que (?:eu )?aprendi:)|(?:\\bhere'?s what (?:i|we) learned\\b)",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "triad",
      "regex": "(?i)(?:\\b\\w+, \\w+ e \\w+\\.)|(?:\\b\\w+, \\w+, and \\w+\\.)",
      "name": "Tríade (regra de três)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e não um desses cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Parede de hashtags (5+)",
      "fix": "No máximo três hashtags. O Instagram não recompensa a parede."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)(?:\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem)\\b)|(?:\\bas an ai\\b|\\bas a language model\\b)",
      "name": "Modelo falando de si",
      "fix": "Apague a frase."
    },
    {
      "id": "in-summary",
      "regex": "(?i)(?:^\\s*(?:em resumo|resumindo|em suma|concluindo|em conclusão)\\b)|(?:^\\s*(?:in summary|to summarize|in conclusion)\\b)",
      "name": "Abertura de redação escolar",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)(?:(?:\\bconcorda\\?|\\bo que (?:vocês|você) acha(?:m)?\\?|\\bquem mais\\b|\\bestou errad[oa]\\?|\\btô errad[oa]\\?)\\s*$)|(?:\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$)",
      "name": "Isca de engajamento automática",
      "fix": "Faça uma pergunta que só você faria, sobre a coisa específica acima dela."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)(?:^\\s*(?:para de rolar|pare de rolar|não passa(?: direto)?|espera,? não passa)\\b)|(?:^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b)",
      "name": "Abertura \"para de rolar\"",
      "fix": "O que faz parar de rolar tem que ser a própria afirmação. Pedir atenção é o sinal de que você não conquistou."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)(?:\\b(?:n(?:e|est)sse (?:vídeo|reels?|post)|no (?:vídeo|reels?) de hoje|hoje (?:eu )?vou te mostrar|(?:eu )?vou te (?:mostrar|ensinar) como)\\b)|(?:\\b(?:in (?:this|today'?s) (?:video|reel|post)|today i'?m going to show you|i'?m going to (?:show|teach) you how)\\b)",
      "name": "Introdução de vídeo (\"neste vídeo eu vou te mostrar\")",
      "fix": "Apague e comece na recompensa. Os dois primeiros segundos decidem o reel inteiro."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista com emoji como marcador",
      "fix": "Use hífen ou quebra de linha. Emoji como marcador é a coisa mais com cara de template numa legenda."
    },
    {
      "id": "caps-shout",
      "regex": "(?:\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,})|(?:\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,})",
      "name": "Três ou mais palavras gritando seguidas",
      "fix": "Caixa alta é volume, não marca-texto. Uma palavra, no máximo."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)(?:\\b(?:segue (?:pra|para) mais|me segue|marca (?:alguém|quem)|dá dois toques|compartilha (?:se|com quem)|comenta (?:aqui )?se)\\b)|(?:\\b(?:follow for more|tag someone who|double tap if|share this if|comment below if)\\b)",
      "name": "Isca automática de seguir ou marcar",
      "fix": "Peça a única ação que esse post realmente merece. O pedido genérico ensina o público a ignorar todos os pedidos."
    }
  ]
}
